# .env del server: si crea una volta da File Manager in
# /home/omniapp/public_html/rollisalpa.omniasoft.app/.env (vedi DEPLOY.md). Mai nel repository.
APP_NAME="Rolli Salpa 4.0"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rollisalpa.omniasoft.app

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=omniapp_rollisalpa
DB_USERNAME=omniapp_rollisalpa
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Token dello script orario sul PC (automazione/pannello.config.json). Almeno 32 caratteri:
# php -r "echo bin2hex(random_bytes(32));"
PANNELLO_SYNC_TOKEN=
